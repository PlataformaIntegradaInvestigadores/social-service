# Local development environment — copy to .env and adjust if needed.
DEBUG=True
SECRET_KEY=change-me-local-secret-key
JWT_SIGNING_KEY=change-me-local-jwt-signing-key
JWT_ALGORITHM=HS256
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:4200

DB_NAME=centinela_social
DB_USER=centinela
DB_PASSWORD=change-me-local-db-password
DB_HOST=social-db
DB_PORT=5432

# REQUIRED: choose your own value. docker-compose starts Redis with
# `--requirepass $REDIS_PASSWORD`, and Django/Channels/Celery use the same
# variable, so there is nothing else to keep in sync. `docker compose up`
# refuses to start if it is empty.
REDIS_HOST=social-redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# Inter-service URLs (centinela-net aliases)
EMBEDDING_SERVICE_URL=http://search-service:8001/api-se/v1
GRS_SERVICE_URL=http://predictive-service:8003/api/v1/recommendations
PROFILE_IDENTITY_BASE_URL=http://identity-service:8002
PROFILE_SYNC_INTERNAL_TOKEN=change-me-local-internal-token

# Optional: name of the Postgres data volume. Leave unset locally; set it only
# on a server that already has a volume under another name (e.g. centinela_postgres_data).
# SOCIAL_DB_VOLUME=social-service_postgres_data

# Hate-speech moderation (hatespeech-service on centinela-net). Leave
# HATESPEECH_SERVICE_URL empty to disable classification: posts/comments stay
# "pending" and visible, and the periodic sweep picks them up once enabled.
HATESPEECH_SERVICE_URL=http://hatespeech-service:8006
# Must match INTERNAL_API_KEY in hatespeech-service's .env.
HATESPEECH_INTERNAL_API_KEY=change-me-local-hatespeech-internal-key
HATESPEECH_TIMEOUT=30
HATESPEECH_EXPLAIN=True
# Comma-separated identity user ids allowed to use the review queue. The JWT
# from identity-service carries no is_staff claim yet, so this is the bridge.
MODERATOR_USER_IDS=
