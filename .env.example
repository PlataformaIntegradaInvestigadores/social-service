# Local development environment — copy to .env and adjust if needed.
DEBUG=True
SECRET_KEY=change-me-local-secret-key
JWT_SIGNING_KEY=change-me-local-jwt-signing-key
JWT_ALGORITHM=HS256
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:4200

DB_NAME=centinela_social
DB_USER=centinela
DB_PASSWORD=change-me-local-db-password
DB_HOST=social-db
DB_PORT=5432

# Must match the `requirepass` in redis.conf
REDIS_HOST=social-redis
REDIS_PORT=6379
REDIS_PASSWORD=admin_redis_centinela

# Inter-service URLs (centinela-net aliases)
EMBEDDING_SERVICE_URL=http://search-service:8001/api-se/v1
GRS_SERVICE_URL=http://predictive-service:8003/api/v1/recommendations
PROFILE_IDENTITY_BASE_URL=http://identity-service:8002
PROFILE_SYNC_INTERNAL_TOKEN=change-me-local-internal-token
